<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/images/setlog-icon.svg" />
    <title>Edit Workout</title>
  </head>
  <body>
    <%- include('../partials/_navbar.ejs') %>

    <main>
      <h1>Edit Workout</h1>

      <div class="form-card">
        <form action="/workouts/<%= workout._id %>?_method=PUT" method="POST">
          
      <label for="title">Title:</label>
      <input type="text" name="title" id="title" value="<%= workout.title %>" required />

      <label for="date">Date:</label>
      <input type="date" name="date" id="date" value="<%= workout.date.toISOString().slice(0, 10) %>" required />

      <label for="weightKg">Your weight today (kg):</label>
      <input type="number" name="weightKg" id="weightKg" min="0" step="0.1" value="<%= workout.weightKg %>" />

      <label for="durationMinutes">Duration (minutes):</label>
      <input type="number" name="durationMinutes" id="durationMinutes" min="1" value="<%= workout.durationMinutes %>" />

      <button type="submit">Save Changes</button>

        </form>
      </div>

      <p class="form-footer"><a href="/workouts/<%= workout._id %>">Cancel</a></p>
    </main>
    <script src="/scripts/loading.js"></script>
  </body>
</html>