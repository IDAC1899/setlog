<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/images/setlog-icon.svg" />
    <title>Exercises</title>
  </head>
  <body>
    <%- include('../partials/_navbar.ejs') %>

    <main>
      <h1>Exercises</h1>
      <p class="meta">Build your exercise library, then log workouts against it.</p>

      <div class="form-card">
        <form action="/exercises" method="POST">
          <label for="name">Name:</label>
          <input type="text" name="name" id="name" required />

          <label for="muscleGroup">Muscle group:</label>
          <input type="text" name="muscleGroup" id="muscleGroup" />

          <button type="submit">Add Exercise</button>
        </form>
      </div>

      <% if(exercises.length){ %>
        <div class="exercise-list">
          <% exercises.forEach((exercise) => { %>
            <div class="exercise-row">
              <div>
                <span class="name"><%= exercise.name %></span>
                <% if(exercise.muscleGroup){ %>
                  <span class="tag"><%= exercise.muscleGroup %></span>
                <%}%>
              </div>

              <form action="/exercises/<%= exercise._id %>?_method=DELETE" method="POST">
                <button type="submit" class="btn-danger">Delete</button>
              </form>
            </div>
          <% }) %>
        </div>
      <% }else{ %>
        <p class="empty">No exercises yet. Add your first one above.</p>
      <%}%>
    </main>

    <script src="/scripts/loading.js"></script>
  </body>
</html>